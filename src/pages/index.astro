---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts';
import { PROJECTS } from '../projects';
import { getCollection } from 'astro:content';

const featured = PROJECTS.filter((p) => p.featured);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const focus = [
	{
		title: 'Systems & simulation',
		body: 'Low-level C++: physics engines, cellular-automata fluid simulation, data structures like quadtrees. Code that has to stay correct and fast.',
	},
	{
		title: 'Performance engineering',
		body: 'Profiling with Tracy, benchmarking, and measuring before optimising — making real-time code actually run in real time.',
	},
	{
		title: 'AI & machine learning',
		body: 'Where I am heading: applying computational and algorithmic thinking to AI — the current focus of my learning and side projects.',
	},
	{
		title: 'Graphics & tooling',
		body: 'Real-time rendering, GLSL shaders, and the debug tooling (ImGui) that makes complex systems understandable.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2.5em 0 1em;
			}
			.hero h1 {
				margin-bottom: 0.3em;
			}
			.hero .role {
				font-size: clamp(1.1rem, 2.5vw, 1.35rem);
				color: var(--text);
				font-weight: 700;
				margin-bottom: 0.8em;
			}
			.hero .lede {
				max-width: 640px;
				font-size: 1.1rem;
			}
			.hero .cta {
				display: flex;
				gap: 0.8em;
				flex-wrap: wrap;
				margin-top: 1.6em;
			}
			.meta {
				display: flex;
				gap: 1.2em;
				flex-wrap: wrap;
				color: var(--text-faint);
				font-family: var(--font-mono);
				font-size: 0.85rem;
				margin-top: 1.4em;
			}

			section {
				margin-top: 3.5em;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 1.4em;
			}
			.section-head a {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				white-space: nowrap;
			}

			.focus-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1em;
			}
			.focus-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.2em 1.3em;
			}
			.focus-card h3 {
				font-size: 1.1rem;
				margin-bottom: 0.3em;
			}
			.focus-card p {
				margin: 0;
				font-size: 0.95rem;
			}

			.proj-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.2em;
			}
			.proj-card {
				display: flex;
				flex-direction: column;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
				transition: border-color 0.15s ease, transform 0.15s ease;
			}
			.proj-card:hover {
				border-color: var(--accent-strong);
				transform: translateY(-2px);
			}
			.proj-card .thumb {
				aspect-ratio: 16 / 9;
				width: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
				border-bottom: 1px solid var(--border);
			}
			.proj-body {
				padding: 1.1em 1.2em 1.3em;
				display: flex;
				flex-direction: column;
				gap: 0.6em;
				flex: 1;
			}
			.proj-body h3 {
				font-size: 1.1rem;
				margin: 0;
			}
			.proj-body p {
				margin: 0;
				font-size: 0.92rem;
				flex: 1;
			}
			.proj-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
			}
			.proj-links {
				display: flex;
				gap: 1em;
				font-size: 0.85rem;
				font-family: var(--font-mono);
				margin-top: 0.3em;
			}

			.posts {
				display: flex;
				flex-direction: column;
			}
			.post-row {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.9em 0;
				border-top: 1px solid var(--border);
			}
			.post-row:last-child {
				border-bottom: 1px solid var(--border);
			}
			.post-row .date {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-faint);
				white-space: nowrap;
				min-width: 110px;
			}
			.post-row a {
				color: var(--text);
				font-weight: 700;
			}
			.post-row a:hover {
				color: var(--accent);
			}

			@media (max-width: 680px) {
				.focus-grid,
				.proj-grid {
					grid-template-columns: 1fr;
				}
				.post-row {
					flex-direction: column;
					gap: 0.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Software Developer</p>
				<h1>Hi, I'm Jayson Malet.</h1>
				<p class="role">I build systems, simulations and tools — and I'm moving toward AI.</p>
				<p class="lede">
					I'm a developer based in Geneva with a strong C++ foundation: physics engines,
					real-time fluid simulation and performance work. I care about code that is correct,
					fast and measurable — and I'm channelling that into machine learning and AI.
				</p>
				<div class="cta">
					<a class="btn btn-primary" href="/projects">View projects</a>
					<a class="btn" href={AUTHOR.github} target="_blank" rel="noopener">GitHub</a>
					{AUTHOR.email && <a class="btn" href={`mailto:${AUTHOR.email}`}>Contact me</a>}
				</div>
				<div class="meta">
					<span>📍 {AUTHOR.location}</span>
					<span>🎓 Games Programming @ SAE Institute</span>
					<span>⚙️ C++ · Python · GLSL</span>
				</div>
			</section>

			<section>
				<div class="section-head"><h2>What I focus on</h2></div>
				<div class="focus-grid">
					{
						focus.map((f) => (
							<div class="focus-card">
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<div class="section-head">
					<h2>Selected projects</h2>
					<a href="/projects">All projects →</a>
				</div>
				<div class="proj-grid">
					{
						featured.map((p) => (
							<article class="proj-card">
								{p.image && <img class="thumb" src={p.image} alt="" loading="lazy" />}
								<div class="proj-body">
									<h3>{p.title}</h3>
									<p>{p.blurb}</p>
									<div class="proj-tags">
										{p.tags.slice(0, 4).map((t) => (
											<span class="tag">{t}</span>
										))}
									</div>
									<div class="proj-links">
										{p.repo && (
											<a href={p.repo} target="_blank" rel="noopener">
												Code ↗
											</a>
										)}
										{p.link && <a href={p.link}>{p.linkLabel ?? 'Details'}</a>}
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section>
				<div class="section-head">
					<h2>Recent writing</h2>
					<a href="/blog">All posts →</a>
				</div>
				<div class="posts">
					{
						posts.map((post) => (
							<div class="post-row">
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
							</div>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
