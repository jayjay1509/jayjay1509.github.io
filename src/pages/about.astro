---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR } from '../consts';

const skills = {
	Languages: ['C++ (C++20)', 'Python', 'C#', 'GLSL'],
	'Systems & simulation': ['Physics engines', 'Cellular automata', 'Quadtrees', 'Collision detection'],
	'Performance & tooling': ['Tracy profiling', 'Benchmarking', 'ImGui', 'CMake / vcpkg'],
	'Graphics & networking': ['OpenGL', 'SFML / SDL2', 'Shaders', 'Client-server (TCP/IP)'],
	'Exploring': ['Machine learning', 'Neural networks', 'Applied AI'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About — Jayson Malet" description="About Jayson Malet — software developer in Geneva focused on systems, simulation and AI." />
		<style>
			.about-head {
				padding: 1.5em 0 0.5em;
			}
			.prose p {
				font-size: 1.05rem;
				color: var(--text-dim);
			}
			.prose p strong {
				color: var(--text);
			}
			h2 {
				margin-top: 2em;
			}
			.skills {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1em;
				margin-top: 1em;
			}
			.skill-group {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1em 1.2em;
			}
			.skill-group h3 {
				font-size: 0.95rem;
				color: var(--accent);
				font-family: var(--font-mono);
				margin-bottom: 0.6em;
			}
			.skill-group .tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
			}
			.contact {
				margin-top: 2.5em;
				display: flex;
				gap: 0.8em;
				flex-wrap: wrap;
			}
			@media (max-width: 640px) {
				.skills {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-head">
				<p class="eyebrow">About</p>
				<h1>Jayson Malet</h1>
			</div>

			<div class="prose">
				<p>
					I'm a developer based in <strong>Geneva</strong>, studying games programming at the
					<strong>SAE Institute</strong>. The label says "games", but what I actually enjoy is
					the engineering underneath: writing <strong>C++</strong> that has to be correct and
					fast, building simulations from first principles, and measuring systems instead of
					guessing.
				</p>
				<p>
					My most substantial project is <strong>Hana-no-saku-ki</strong>, my Bachelor thesis:
					a real-time 2D fluid simulation built on cellular automata, without a physics engine.
					Each grid cell follows simple local rules and realistic fluid behaviour emerges from
					them. A big part of that work was <strong>profiling and optimisation</strong> —
					using Tracy and CSV benchmarks to make the simulation genuinely run in real time.
				</p>
				<p>
					Alongside it I've built a <strong>2D physics engine</strong> (forces, collisions and a
					quadtree for broad-phase detection), a <strong>multiplayer chess</strong> game over a
					client-server architecture, real-time <strong>3D graphics</strong> and GLSL shaders.
				</p>
				<p>
					Where I'm heading now is <strong>AI and machine learning</strong>. The same
					foundations — algorithms, data structures, numerical thinking and performance — are
					exactly what that field runs on, and it's the focus of my current learning and side
					projects.
				</p>
			</div>

			<h2>Skills</h2>
			<div class="skills">
				{
					Object.entries(skills).map(([group, items]) => (
						<div class="skill-group">
							<h3>{group}</h3>
							<div class="tags">
								{items.map((s) => (
									<span class="tag">{s}</span>
								))}
							</div>
						</div>
					))
				}
			</div>

			<h2>Get in touch</h2>
			<p class="muted">I'm open to internships, collaborations and interesting problems.</p>
			<div class="contact">
				<a class="btn btn-primary" href={AUTHOR.github} target="_blank" rel="noopener">GitHub</a>
				<a class="btn" href={AUTHOR.x} target="_blank" rel="noopener">X / Twitter</a>
				{AUTHOR.email && <a class="btn" href={`mailto:${AUTHOR.email}`}>Email</a>}
			</div>
		</main>
		<Footer />
	</body>
</html>
