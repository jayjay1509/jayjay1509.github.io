---
import BaseHead from '../BaseHead.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import FormattedDate from '../FormattedDate.astro';
import { UI, getLang } from '../../i18n';
import { getCollection } from 'astro:content';

const lang = getLang(Astro.url.pathname);
const t = UI[lang];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t.nav.writing} — Jayson Malet`} description={t.writingPageIntro} />
		<style>
			.page-head {
				padding: 1.5em 0 0.5em;
			}
			.page-head p {
				max-width: 620px;
			}
			ul {
				list-style: none;
				margin: 2em 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.4em;
			}
			li a {
				display: flex;
				flex-direction: column;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
				height: 100%;
				transition: border-color 0.15s ease, transform 0.15s ease;
			}
			li a:hover {
				border-color: var(--accent-strong);
				transform: translateY(-2px);
			}
			li img {
				aspect-ratio: 16 / 9;
				width: 100%;
				object-fit: cover;
				border-radius: 0;
				border-bottom: 1px solid var(--border);
			}
			.card-body {
				padding: 1em 1.2em 1.3em;
			}
			.title {
				color: #fff;
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.3;
				margin: 0 0 0.3em;
			}
			.desc {
				color: var(--text-dim);
				font-size: 0.92rem;
				margin: 0 0 0.6em;
			}
			.date {
				color: var(--text-faint);
				font-family: var(--font-mono);
				font-size: 0.78rem;
			}
			@media (max-width: 640px) {
				ul {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<p class="eyebrow">{t.nav.writing}</p>
				<h1>{t.writingPageTitle}</h1>
				<p>{t.writingPageIntro}</p>
				{t.writingNote && <p class="muted">{t.writingNote}</p>}
			</div>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.slug}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" loading="lazy" />
									)}
									<div class="card-body">
										<p class="title">{post.data.title}</p>
										<p class="desc">{post.data.description}</p>
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
