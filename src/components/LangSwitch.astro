---
import { getLang, switchPath } from '../i18n';

const lang = getLang(Astro.url.pathname);
const enHref = switchPath(Astro.url.pathname, 'en');
const frHref = switchPath(Astro.url.pathname, 'fr');
---

<div class="lang-switch">
	<a href={enHref} class:list={{ active: lang === 'en' }} hreflang="en" lang="en" title="English">
		<span class="sr-only">English</span>
		<svg viewBox="0 0 60 30" width="24" height="12" aria-hidden="true">
			<clipPath id="uk-s"><path d="M0,0 v30 h60 v-30 z"></path></clipPath>
			<clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"></path></clipPath>
			<g clip-path="url(#uk-s)">
				<path d="M0,0 v30 h60 v-30 z" fill="#012169"></path>
				<path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"></path>
				<path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4"></path>
				<path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"></path>
				<path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"></path>
			</g>
		</svg>
	</a>
	<a href={frHref} class:list={{ active: lang === 'fr' }} hreflang="fr" lang="fr" title="Français">
		<span class="sr-only">Français</span>
		<svg viewBox="0 0 3 2" width="18" height="12" aria-hidden="true">
			<rect width="1" height="2" x="0" fill="#002395"></rect>
			<rect width="1" height="2" x="1" fill="#fff"></rect>
			<rect width="1" height="2" x="2" fill="#ED2939"></rect>
		</svg>
	</a>
</div>

<style>
	.lang-switch {
		display: flex;
		gap: 0.45em;
		align-items: center;
	}
	.lang-switch a {
		display: flex;
		padding: 4px;
		border-radius: 6px;
		border: 1px solid transparent;
		opacity: 0.45;
		transition: opacity 0.15s ease, border-color 0.15s ease;
	}
	.lang-switch a:hover {
		opacity: 1;
	}
	.lang-switch a.active {
		opacity: 1;
		border-color: var(--border);
		background: var(--bg-card);
	}
	.lang-switch svg {
		display: block;
		border-radius: 2px;
	}
</style>
