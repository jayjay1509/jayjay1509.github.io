---
interface Props {
	date: Date;
}

import { getLang } from '../i18n';

const { date } = Astro.props;
const locale = getLang(Astro.url.pathname) === 'fr' ? 'fr-CH' : 'en-GB';
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
